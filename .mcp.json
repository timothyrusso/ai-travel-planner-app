{
  "mcpServers": {
    "codegraph": {
      "type": "stdio",
      "command": "npx",
      "args": ["--no-install", "codegraph", "serve", "--mcp"]
    },
    "open-pencil": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "-c",
        "OPENPENCIL_MCP_ROOT=\"$(git rev-parse --show-toplevel)\" exec npx --no-install openpencil-mcp"
      ]
    }
  }
}
