FIREBASE_MOBILE_APP_ID==
GOOGLE_PLACES_API_KEY=
GOOGLE_GEMINI_API_KEY=
RAPID_API_KEY=
UNSPLASH_ACCESS_KEY=
GOOGLE_SERVICES_PLIST_LOCAL_PATH=/Users/USER_NAME/LOCATION_OF_THE_PROJECT/HolidAI/GoogleService-Info.plist
GOOGLE_SERVICES_JSON_LOCAL_PATH=/Users/USER_NAME/LOCATION_OF_THE_PROJECT/HolidAI/google-services.json
GOOGLE_MAPS_API_KEY_ANDROID=
GOOGLE_MAPS_API_KEY_IOS=
OPEN_AI_API_KEY=
MMKV_ENCRYPTION_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWT_ISSUER_DOMAIN=
CONVEX_URL=
# QA sign-in identifier for device QA. Use a Clerk `+clerk_test` email
# (e.g. your-qa+clerk_test@example.com); its verification code is the fixed 424242
# on the pk_test dev instance. Read by the qa-baseline skill; not used by the app.
QA_TEST_EMAIL=
SENTRY_DSN=
APPLE_TEAM_ID=
# Boots Storybook instead of the app. Normally you do NOT set this here: the
# `storybook:ios` / `storybook:android` scripts pass it inline for one command, and
# metro.config.js uses it to strip Storybook from the bundle when it is not `true`.
# Setting it to `true` in `.env` makes EVERY `npm run ios` / `npm run android` boot
# Storybook instead of the app, so leave it commented out unless that is what you want.
# EXPO_PUBLIC_STORYBOOK_ENABLED=true